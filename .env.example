# Copie para .env.local (uso local) ou cadastre estes nomes no painel da Vercel.
# Este arquivo vai para o Git: deixe os valores vazios.
# Nunca use o prefixo VITE_ aqui, pois ele expõe o valor no navegador.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# true = TLS com certificado validado | no-verify = TLS sem validar (certificado autoassinado) | false = sem TLS
DB_SSL=true
